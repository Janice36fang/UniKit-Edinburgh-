# Optional. The MVP is fully usable without keys and will label fallback data clearly.
PORT=4173
HOST=127.0.0.1

# AI contract and free-text parsing (server-side only)
# Recommended no-top-up portfolio setup: create a free key in Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_MODEL_ALLOWLIST=gemini-3.1-flash-lite,gemini-3-flash-preview
GEMINI_DAILY_LIMIT=8
AI_DEFAULT_SOURCE=gemini

# Optional paid alternative
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_MODEL_ALLOWLIST=gpt-5-mini,gpt-5.4-mini

# Live UK product search (server-side only)
SERPAPI_API_KEY=
PRODUCT_MERCHANT_ALLOWLIST=Argos,IKEA,Dunelm,John Lewis,Tesco,ASDA
